{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek Harness 桌面端：Electron 壳内嵌启动 dsh web，复用本机 $DSH_HOME 的配置、插件与会话；托盘/自启/快捷键/原生通知/GitHub 自动更新",
  "author": "dsh-desktop",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "verify": "node scripts/verify-server.js",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "dist": "set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "scripts/verify-server.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "artifactName": "DeepSeek-Harness-Desktop-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "AyaXshiN",
      "repo": "dsh-desktop"
    }
  }
}
